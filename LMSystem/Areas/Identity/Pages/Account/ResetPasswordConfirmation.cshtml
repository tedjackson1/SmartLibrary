@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Reset password confirmation";
}

<section class="status-page"
         aria-labelledby="resetPasswordConfirmationTitle">
    <div class="status-page-card">
        <div class="status-page-icon success"
             aria-hidden="true">
            <i class="bi bi-shield-check"></i>
        </div>

        <div class="status-code">
            Password Updated
        </div>

        <h1 id="resetPasswordConfirmationTitle">
            @ViewData["Title"]
        </h1>

        <p>
            Your password has been reset successfully.
        </p>

        <div class="status-information-box"
             role="status">
            <i class="bi bi-check-circle-fill"
               aria-hidden="true"></i>

            <span>
                You can now use your new password to access your account.
            </span>
        </div>

        <div class="status-page-actions">
            <a asp-page="./Login"
               class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right"
                   aria-hidden="true"></i>

                <span>
                    Click here to log in
                </span>
            </a>
        </div>
    </div>
</section>