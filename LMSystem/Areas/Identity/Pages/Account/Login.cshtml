@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <div class="auth-container">
        <section class="auth-visual"
                 aria-label="Library account login">
            <div class="auth-visual-content">
                <div class="auth-logo">
                    <span class="auth-logo-icon"
                          aria-hidden="true">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span>
                        <strong>
                            LibSphere
                        </strong>

                        <small>
                            Library Management System
                        </small>
                    </span>
                </div>
            </div>

            <div class="auth-visual-copy">
                <h2>
                    Welcome back to your library workspace.
                </h2>

                <p>
                    Sign in securely to access your account and continue
                    managing library records and resources.
                </p>
            </div>

            <div class="auth-features">
                <div class="auth-feature">
                    <i class="bi bi-shield-lock"
                       aria-hidden="true"></i>

                    <span>
                        Secure account access
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-journal-bookmark"
                       aria-hidden="true"></i>

                    <span>
                        Manage library resources
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-people"
                       aria-hidden="true"></i>

                    <span>
                        Access member records
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-arrow-left-right"
                       aria-hidden="true"></i>

                    <span>
                        Manage borrowing activity
                    </span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel"
                 aria-labelledby="identityLoginTitle">
            <div class="auth-form-header">
                <p class="page-eyebrow">
                    Account Access
                </p>

                <h1 id="identityLoginTitle">
                    @ViewData["Title"]
                </h1>

                <p>
                    Use your registered account details to continue.
                </p>
            </div>

            <form id="account"
                  method="post">
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors text-danger"
                     role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email"
                           class="form-label">
                        Email Address
                    </label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com"
                               autofocus />
                    </div>

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.Password"
                               id="identityPassword"
                               class="form-control pe-5"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />

                        <button type="button"
                                class="password-toggle-button"
                                data-password-toggle
                                data-password-target="identityPassword"
                                aria-label="Show password"
                                title="Show password">
                            <i class="bi bi-eye"
                               aria-hidden="true"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                    <div class="form-check mb-0">
                        <input asp-for="Input.RememberMe"
                               class="form-check-input" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label">
                            @Html.DisplayNameFor(model => model.Input.RememberMe)
                        </label>
                    </div>

                    <a id="forgot-password"
                       asp-page="./ForgotPassword"
                       class="fw-semibold">
                        Forgot password?
                    </a>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    <i class="bi bi-box-arrow-in-right"
                       aria-hidden="true"></i>

                    <span>
                        Log in
                    </span>
                </button>

                <div class="auth-form-footer">
                    <p class="mb-2">
                        Don’t have an account?
                    </p>

                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="fw-semibold">
                        Register as a new user
                    </a>

                    <span class="mx-2" aria-hidden="true">
                        •
                    </span>

                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation"
                       class="fw-semibold">
                        Resend email confirmation
                    </a>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-divider">
                    <span>
                        Or continue with
                    </span>
                </div>

                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">
                    <div class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            string providerDisplayName =
                                provider.DisplayName ?? provider.Name;

                            <button type="submit"
                                    class="btn btn-outline-secondary"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Log in using your @providerDisplayName account">
                                <i class="bi bi-box-arrow-in-up-right"
                                   aria-hidden="true"></i>

                                <span>
                                    Continue with @providerDisplayName
                                </span>
                            </button>
                        }
                    </div>
                </form>
            }

            <div class="auth-form-footer">
                <i class="bi bi-shield-check me-1"
                   aria-hidden="true"></i>

                Account authentication is handled securely through
                ASP.NET Core Identity.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}