@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="auth-page">
    <div class="auth-container">
        <section class="auth-visual"
                 aria-label="Password recovery">
            <div class="auth-visual-content">
                <div class="auth-logo">
                    <span class="auth-logo-icon"
                          aria-hidden="true">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span>
                        <strong>
                            LibSphere
                        </strong>

                        <small>
                            Library Management System
                        </small>
                    </span>
                </div>
            </div>

            <div class="auth-visual-copy">
                <h2>
                    Recover access to your library account.
                </h2>

                <p>
                    Enter the email address connected to your account
                    to begin the password-reset process.
                </p>
            </div>

            <div class="auth-features">
                <div class="auth-feature">
                    <i class="bi bi-envelope"
                       aria-hidden="true"></i>

                    <span>
                        Enter your registered email
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-shield-lock"
                       aria-hidden="true"></i>

                    <span>
                        Secure password recovery
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-key"
                       aria-hidden="true"></i>

                    <span>
                        Reset your account password
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-person-check"
                       aria-hidden="true"></i>

                    <span>
                        Restore account access
                    </span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel"
                 aria-labelledby="forgotPasswordTitle">
            <div class="auth-form-header">
                <p class="page-eyebrow">
                    Account Recovery
                </p>

                <h1 id="forgotPasswordTitle">
                    @ViewData["Title"]
                </h1>

                <p>
                    Enter your email.
                </p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary-errors"
                     role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />

                    <label asp-for="Input.Email"
                           class="form-label"></label>

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    <i class="bi bi-send"
                       aria-hidden="true"></i>

                    <span>
                        Reset Password
                    </span>
                </button>
            </form>

            <div class="auth-form-footer">
                <i class="bi bi-shield-check me-1"
                   aria-hidden="true"></i>

                Password recovery is handled securely through
                ASP.NET Core Identity.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}