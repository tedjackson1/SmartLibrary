@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-page">
    <div class="auth-container">
        <section class="auth-visual"
                 aria-label="Password reset">
            <div class="auth-visual-content">
                <div class="auth-logo">
                    <span class="auth-logo-icon"
                          aria-hidden="true">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span>
                        <strong>
                            LibSphere
                        </strong>

                        <small>
                            Library Management System
                        </small>
                    </span>
                </div>
            </div>

            <div class="auth-visual-copy">
                <h2>
                    Create a new secure password.
                </h2>

                <p>
                    Enter your account email and choose a new password
                    to restore access to your library account.
                </p>
            </div>

            <div class="auth-features">
                <div class="auth-feature">
                    <i class="bi bi-envelope"
                       aria-hidden="true"></i>

                    <span>
                        Confirm your account email
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-key"
                       aria-hidden="true"></i>

                    <span>
                        Create a new password
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-shield-lock"
                       aria-hidden="true"></i>

                    <span>
                        Secure password reset
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-person-check"
                       aria-hidden="true"></i>

                    <span>
                        Restore account access
                    </span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel"
                 aria-labelledby="resetPasswordTitle">
            <div class="auth-form-header">
                <p class="page-eyebrow">
                    Account Recovery
                </p>

                <h1 id="resetPasswordTitle">
                    @ViewData["Title"]
                </h1>

                <p>
                    Reset your password.
                </p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors text-danger"
                     role="alert"></div>

                <input asp-for="Input.Code"
                       type="hidden" />

                <div class="mb-4">
                    <label asp-for="Input.Email"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com"
                               autofocus />
                    </div>

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please enter your password." />
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock-fill input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please confirm your password." />
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    <i class="bi bi-arrow-repeat"
                       aria-hidden="true"></i>

                    <span>
                        Reset
                    </span>
                </button>
            </form>

            <div class="auth-form-footer">
                <i class="bi bi-shield-check me-1"
                   aria-hidden="true"></i>

                Password resetting is securely handled through
                ASP.NET Core Identity.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}