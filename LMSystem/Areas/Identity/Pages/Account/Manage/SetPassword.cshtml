@page
@model SetPasswordModel

@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="app-card">
    <div class="app-card-header">
        <div>
            <h3 class="section-title">
                <i class="bi bi-key-fill me-2"
                   aria-hidden="true"></i>

                Set your password
            </h3>

            <p class="section-description">
                Add a local password so you can sign in without using
                an external login provider.
            </p>
        </div>

        <span class="type-badge">
            <i class="bi bi-shield-lock"
               aria-hidden="true"></i>

            Account Security
        </span>
    </div>

    <div class="app-card-body">
        <partial name="_StatusMessage"
                 for="StatusMessage" />

        <div class="custom-alert custom-alert-info"
             role="status">
            <span class="custom-alert-icon"
                  aria-hidden="true">
                <i class="bi bi-info-circle-fill"></i>
            </span>

            <div class="custom-alert-content">
                <strong>
                    Local password not configured
                </strong>

                <p>
                    You do not have a local username/password for this site.
                    Add a local account so you can log in without an external login.
                </p>
            </div>
        </div>

        <form id="set-password-form"
              method="post">
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors text-danger"
                 role="alert"></div>

            <div class="form-section">
                <div class="mb-4">
                    <label asp-for="Input.NewPassword"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-lock input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.NewPassword"
                               class="form-control pe-5"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please enter your new password." />

                        <button type="button"
                                class="password-toggle-button"
                                data-password-toggle
                                data-password-target="Input_NewPassword"
                                aria-label="Show new password"
                                title="Show new password">
                            <i class="bi bi-eye"
                               aria-hidden="true"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.NewPassword"
                          class="text-danger"></span>

                    <div class="form-text">
                        Choose a password that satisfies the password rules
                        configured for this application.
                    </div>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-check2-circle input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control pe-5"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Please confirm your new password." />

                        <button type="button"
                                class="password-toggle-button"
                                data-password-toggle
                                data-password-target="Input_ConfirmPassword"
                                aria-label="Show confirmed password"
                                title="Show confirmed password">
                            <i class="bi bi-eye"
                               aria-hidden="true"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn btn-primary btn-lg">
                    <i class="bi bi-shield-check"
                       aria-hidden="true"></i>

                    <span>
                        Set password
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}