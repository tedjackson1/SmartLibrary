@page
@model EmailModel

@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="app-card">
    <div class="app-card-header">
        <div>
            <h3 class="section-title">
                <i class="bi bi-envelope-at me-2"
                   aria-hidden="true"></i>

                @ViewData["Title"]
            </h3>

            <p class="section-description">
                Review your current email address, verify it and request
                an email-address change.
            </p>
        </div>

        <span class="type-badge">
            <i class="bi bi-shield-check"
               aria-hidden="true"></i>

            Account Email
        </span>
    </div>

    <div class="app-card-body">
        <partial name="_StatusMessage"
                 for="StatusMessage" />

        <form id="email-form"
              method="post">
            <div asp-validation-summary="All"
                 class="validation-summary-errors text-danger"
                 role="alert"></div>

            <div class="form-section">
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <label asp-for="Email"
                               class="form-label mb-0">
                            Current Email
                        </label>

                        @if (Model.IsEmailConfirmed)
                        {
                            <span class="status-badge status-success">
                                Confirmed
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-warning">
                                Unverified
                            </span>
                        }
                    </div>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Please enter your email."
                               disabled />
                    </div>

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="custom-alert custom-alert-success mt-3"
                             role="status">
                            <span class="custom-alert-icon"
                                  aria-hidden="true">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>

                            <div class="custom-alert-content">
                                <strong>
                                    Email confirmed
                                </strong>

                                <p>
                                    Your current email address has been verified.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="custom-alert custom-alert-warning mt-3"
                             role="alert">
                            <span class="custom-alert-icon"
                                  aria-hidden="true">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </span>

                            <div class="custom-alert-content">
                                <strong>
                                    Verification required
                                </strong>

                                <p>
                                    Your current email address has not yet
                                    been confirmed.
                                </p>
                            </div>
                        </div>

                        <button id="email-verification"
                                type="submit"
                                asp-page-handler="SendVerificationEmail"
                                class="btn btn-outline-primary mt-3">
                            <i class="bi bi-send"
                               aria-hidden="true"></i>

                            <span>
                                Send verification email
                            </span>
                        </button>
                    }
                </div>

                <div>
                    <label asp-for="Input.NewEmail"
                           class="form-label">
                        New Email
                    </label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope-plus input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.NewEmail"
                               class="form-control"
                               autocomplete="email"
                               aria-required="true"
                               placeholder="Please enter new email." />
                    </div>

                    <span asp-validation-for="Input.NewEmail"
                          class="text-danger"></span>

                    <div class="form-text">
                        Enter a new address only when you want to change
                        the email connected to this account.
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button id="change-email-button"
                        type="submit"
                        asp-page-handler="ChangeEmail"
                        class="btn btn-primary btn-lg">
                    <i class="bi bi-check-circle"
                       aria-hidden="true"></i>

                    <span>
                        Change email
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}