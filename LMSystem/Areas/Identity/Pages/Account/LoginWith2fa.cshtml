@page
@model LoginWith2faModel

@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="auth-page">
    <div class="auth-container">
        <section class="auth-visual"
                 aria-label="Two-factor authentication">
            <div class="auth-visual-content">
                <div class="auth-logo">
                    <span class="auth-logo-icon"
                          aria-hidden="true">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span>
                        <strong>
                            LibSphere
                        </strong>

                        <small>
                            Library Management System
                        </small>
                    </span>
                </div>
            </div>

            <div class="auth-visual-copy">
                <h2>
                    Protecting your library account.
                </h2>

                <p>
                    Enter the verification code generated by your
                    authenticator application to complete the login process.
                </p>
            </div>

            <div class="auth-features">
                <div class="auth-feature">
                    <i class="bi bi-shield-lock"
                       aria-hidden="true"></i>

                    <span>
                        Secure account verification
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-phone"
                       aria-hidden="true"></i>

                    <span>
                        Authenticator application support
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-key"
                       aria-hidden="true"></i>

                    <span>
                        Recovery-code login available
                    </span>
                </div>

                <div class="auth-feature">
                    <i class="bi bi-person-check"
                       aria-hidden="true"></i>

                    <span>
                        Additional account protection
                    </span>
                </div>
            </div>
        </section>

        <section class="auth-form-panel"
                 aria-labelledby="twoFactorLoginTitle">
            <div class="auth-form-header">
                <p class="page-eyebrow">
                    Security Verification
                </p>

                <h1 id="twoFactorLoginTitle">
                    @ViewData["Title"]
                </h1>

                <p>
                    Your login is protected with an authenticator app.
                    Enter your authenticator code below.
                </p>
            </div>

            <form method="post"
                  asp-route-returnUrl="@Model.ReturnUrl">
                <input asp-for="RememberMe"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors text-danger"
                     role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.TwoFactorCode"
                           class="form-label"></label>

                    <div class="input-icon-wrapper">
                        <i class="bi bi-shield-check input-icon"
                           aria-hidden="true"></i>

                        <input asp-for="Input.TwoFactorCode"
                               class="form-control"
                               autocomplete="off"
                               inputmode="numeric"
                               placeholder="Enter authenticator code"
                               autofocus />
                    </div>

                    <span asp-validation-for="Input.TwoFactorCode"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Input.RememberMachine"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMachine"
                           class="form-check-label">
                        @Html.DisplayNameFor(
                            model => model.Input.RememberMachine
                        )
                    </label>
                </div>

                <button type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    <i class="bi bi-box-arrow-in-right"
                       aria-hidden="true"></i>

                    <span>
                        Log in
                    </span>
                </button>
            </form>

            <div class="auth-form-footer">
                <p class="mb-2">
                    Don’t have access to your authenticator device?
                </p>

                <a id="recovery-code-login"
                   asp-page="./LoginWithRecoveryCode"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="fw-semibold">
                    <i class="bi bi-key me-1"
                       aria-hidden="true"></i>

                    Log in with a recovery code
                </a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}