@model LMSystem.Models.LibrarianModel

@{
    ViewData["Title"] = "Add Librarian";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Librarian Management
            </p>

            <h2 class="page-title">
                Add Librarian
            </h2>

            <p class="page-description">
                Enter the librarian’s information to create a new record
                in the library system.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to Librarians
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="addLibrarianFormTitle">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-7">
                <div class="app-card">
                    <div class="app-card-header">
                        <div>
                            <h3 id="addLibrarianFormTitle"
                                class="section-title">
                                <i class="bi bi-person-plus me-2"
                                   aria-hidden="true"></i>

                                Librarian Information
                            </h3>

                            <p class="section-description">
                                Complete all fields before adding the
                                librarian record.
                            </p>
                        </div>
                    </div>

                    <div class="app-card-body">
                        <form asp-action="Create"
                              method="post"
                              onsubmit="return validateForm();">
                            <div class="form-section">
                                <div class="mb-4">
                                    <label asp-for="Name"
                                           class="form-label">
                                        Name

                                        <span class="required-mark"
                                              aria-hidden="true">
                                            *
                                        </span>
                                    </label>

                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-person input-icon"
                                           aria-hidden="true"></i>

                                        <input asp-for="Name"
                                               class="form-control"
                                               placeholder="Enter the librarian's name" />
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Age"
                                           class="form-label">
                                        Age

                                        <span class="required-mark"
                                              aria-hidden="true">
                                            *
                                        </span>
                                    </label>

                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-calendar-person input-icon"
                                           aria-hidden="true"></i>

                                        <input asp-for="Age"
                                               type="number"
                                               class="form-control"
                                               placeholder="Enter the librarian's age" />
                                    </div>
                                </div>

                                <div>
                                    <label asp-for="Phone"
                                           class="form-label">
                                        Phone

                                        <span class="required-mark"
                                              aria-hidden="true">
                                            *
                                        </span>
                                    </label>

                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-telephone input-icon"
                                           aria-hidden="true"></i>

                                        <input asp-for="Phone"
                                               class="form-control"
                                               placeholder="Enter the librarian's phone number" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit"
                                        class="btn btn-success">
                                    <i class="bi bi-person-check"
                                       aria-hidden="true"></i>

                                    <span>
                                        Add
                                    </span>
                                </button>

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle"
                                       aria-hidden="true"></i>

                                    <span>
                                        Cancel
                                    </span>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    function validateForm() {
        const name =
            document.querySelector('[name="Name"]').value.trim();

        const age =
            document.querySelector('[name="Age"]').value.trim();

        const phone =
            document.querySelector('[name="Phone"]').value.trim();

        if (!name || !age || !phone) {
            alert("All fields are required: Name, Age, and Phone.");
            return false;
        }

        return true;
    }
</script>