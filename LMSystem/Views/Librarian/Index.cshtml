@model LMSystem.Models.LibrarianIndexViewModel

@{
    ViewData["Title"] = "Librarians";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Library Administration
            </p>

            <h2 class="page-title">
                Librarians
            </h2>

            <p class="page-description">
                Search, view and manage librarian records registered in the
                library system.
            </p>
        </div>

        <div class="page-header-actions">
            <a class="btn btn-primary"
               href="/Librarian/Create">
                <i class="bi bi-person-plus"
                   aria-hidden="true"></i>

                <span>
                    Add New Librarian
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="librarianRecordsTitle">
        <div class="section-header">
            <div>
                <h3 id="librarianRecordsTitle"
                    class="section-title">
                    Librarian Records
                </h3>

                <p class="section-description">
                    View the librarians currently stored in the system.
                </p>
            </div>
        </div>

        <div class="list-toolbar">
            <div class="list-toolbar-left">
                <form method="get"
                      action="/Librarian/Index"
                      class="search-form d-flex align-items-center gap-2"
                      role="search">
                    <div class="search-input-group flex-grow-1">
                        <i class="bi bi-search search-icon"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search by name..."
                               aria-label="Search librarians by name" />

                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <a href="/Librarian/Index"
                               class="search-clear-button"
                               aria-label="Clear librarian search"
                               title="Clear search">
                                <i class="bi bi-x-lg"
                                   aria-hidden="true"></i>
                            </a>
                        }
                    </div>

                    <button type="submit"
                            class="btn btn-outline-primary">
                        <i class="bi bi-search"
                           aria-hidden="true"></i>

                        <span>
                            Search
                        </span>
                    </button>
                </form>
            </div>

            <div class="list-toolbar-right">
                <div class="result-summary">
                    <strong>
                        @Model.Librarians.Count
                    </strong>

                    @(Model.Librarians.Count == 1
                        ? "librarian"
                        : "librarians")

                    on this page
                </div>
            </div>
        </div>

        @if (Model.Librarians.Any())
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th scope="col">
                                    Librarian
                                </th>

                                <th scope="col">
                                    Librarian ID
                                </th>

                                <th scope="col">
                                    Age
                                </th>

                                <th scope="col">
                                    Phone
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Librarians)
                            {
                                <tr>
                                    <td>
                                        <div class="table-cell-with-icon">
                                            <span class="table-avatar"
                                                  aria-hidden="true">
                                                <i class="bi bi-person-workspace"></i>
                                            </span>

                                            <div class="table-cell-stack">
                                                <span class="table-primary-text">
                                                    @item.Name
                                                </span>

                                                <span class="table-secondary-text">
                                                    Registered librarian
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="type-badge">
                                            <i class="bi bi-hash"
                                               aria-hidden="true"></i>

                                            @item.LibrarianId
                                        </span>
                                    </td>

                                    <td>
                                        <span class="table-primary-text">
                                            @item.Age
                                        </span>
                                    </td>

                                    <td>
                                        <div class="table-cell-with-icon">
                                            <i class="bi bi-telephone text-muted-custom"
                                               aria-hidden="true"></i>

                                            <span>
                                                @item.Phone
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="table-actions">
                                            <a class="btn btn-sm btn-soft-warning"
                                               href="/Librarian/Edit/@item.LibrarianId"
                                               title="Edit @item.Name">
                                                <i class="bi bi-pencil-square"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Edit
                                                </span>
                                            </a>

                                            <a class="btn btn-sm btn-soft-danger"
                                               href="/Librarian/Delete/@item.LibrarianId"
                                               onclick="return confirm('Are you sure?')"
                                               title="Delete @item.Name">
                                                <i class="bi bi-trash3"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Delete
                                                </span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="table-card-footer">
                        <div class="result-summary">
                            Page

                            <strong>
                                @Model.CurrentPage
                            </strong>

                            of

                            <strong>
                                @Model.TotalPages
                            </strong>
                        </div>

                        <nav aria-label="Librarian page navigation">
                            <ul class="pagination">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)"
                                       aria-label="Previous page">
                                        <i class="bi bi-chevron-left"
                                           aria-hidden="true"></i>

                                        <span class="d-none d-sm-inline">
                                            Previous
                                        </span>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link"
                                           href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@i"
                                           aria-current="@(Model.CurrentPage == i ? "page" : null)">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)"
                                       aria-label="Next page">
                                        <span class="d-none d-sm-inline">
                                            Next
                                        </span>

                                        <i class="bi bi-chevron-right"
                                           aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="empty-state">
                    <div class="empty-state-icon"
                         aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <i class="bi bi-person-x"></i>
                        }
                        else
                        {
                            <i class="bi bi-person-workspace"></i>
                        }
                    </div>

                    <h3>
                        No records found.
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <p>
                            No librarian records matched
                            “@Model.SearchTerm”. Try searching with another name.
                        </p>

                        <a href="/Librarian/Index"
                           class="btn btn-outline-primary">
                            <i class="bi bi-arrow-counterclockwise"
                               aria-hidden="true"></i>

                            <span>
                                Clear Search
                            </span>
                        </a>
                    }
                    else
                    {
                        <p>
                            There are currently no librarian records stored
                            in the library system.
                        </p>

                        <a href="/Librarian/Create"
                           class="btn btn-primary">
                            <i class="bi bi-person-plus"
                               aria-hidden="true"></i>

                            <span>
                                Add New Librarian
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>