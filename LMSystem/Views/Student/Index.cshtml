@model LMSystem.Models.StudentIndexViewModel

@{
    ViewData["Title"] = "Students";

    int displayedStudentCount = Model.Students.Count;
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Library Members
            </p>

            <h2 class="page-title">
                Students
            </h2>

            <p class="page-description">
                Search, view and manage the student records registered in the
                library system.
            </p>
        </div>

        <div class="page-header-actions">
            <a class="btn btn-primary"
               href="/Student/Create">
                <i class="bi bi-person-plus"
                   aria-hidden="true"></i>

                <span>
                    Add New Student
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="studentRecordsTitle">
        <div class="list-toolbar">
            <div class="list-toolbar-left">
                <form method="get"
                      action="/Student/Index"
                      class="search-form"
                      role="search">
                    <div class="search-input-group">
                        <i class="bi bi-search search-icon"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search by name, email or phone"
                               aria-label="Search student records" />

                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <a href="/Student/Index"
                               class="search-clear-button"
                               aria-label="Clear student search"
                               title="Clear search">
                                <i class="bi bi-x-lg"
                                   aria-hidden="true"></i>
                            </a>
                        }
                    </div>

                    <button type="submit"
                            class="btn btn-outline-primary">
                        <i class="bi bi-search"
                           aria-hidden="true"></i>

                        <span>
                            Search
                        </span>
                    </button>
                </form>
            </div>

            <div class="list-toolbar-right">
                <div class="result-summary">
                    <strong>
                        @displayedStudentCount
                    </strong>

                    @(displayedStudentCount == 1 ? "student" : "students")
                    on this page
                </div>
            </div>
        </div>

        @if (Model.Students.Count > 0)
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th scope="col">
                                    Student
                                </th>

                                <th scope="col">
                                    Student ID
                                </th>

                                <th scope="col">
                                    Email
                                </th>

                                <th scope="col">
                                    Phone
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Students)
                            {
                                string studentInitial =
                                    !string.IsNullOrWhiteSpace(item.StudentName)
                                        ? item.StudentName.Substring(0, 1).ToUpper()
                                        : "S";

                                <tr>
                                    <td>
                                        <div class="table-cell-with-icon">
                                            <span class="table-avatar"
                                                  aria-hidden="true">
                                                @studentInitial
                                            </span>

                                            <div class="table-cell-stack">
                                                <span class="table-primary-text">
                                                    @item.StudentName
                                                </span>

                                                <span class="table-secondary-text">
                                                    Registered student
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="type-badge">
                                            <i class="bi bi-hash"
                                               aria-hidden="true"></i>

                                            @item.StudentId
                                        </span>
                                    </td>

                                    <td>
                                        <a href="mailto:@item.Email"
                                           class="table-contact-link">
                                            <i class="bi bi-envelope"
                                               aria-hidden="true"></i>

                                            <span>
                                                @item.Email
                                            </span>
                                        </a>
                                    </td>

                                    <td>
                                        <a href="tel:@item.Phone"
                                           class="table-contact-link">
                                            <i class="bi bi-telephone"
                                               aria-hidden="true"></i>

                                            <span>
                                                @item.Phone
                                            </span>
                                        </a>
                                    </td>

                                    <td>
                                        <div class="table-actions">
                                            <a class="btn btn-sm btn-soft-warning"
                                               href="/Student/Edit/@item.StudentId"
                                               title="Edit @item.StudentName">
                                                <i class="bi bi-pencil-square"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Edit
                                                </span>
                                            </a>

                                            <a class="btn btn-sm btn-soft-danger"
                                               href="/Student/Delete/@item.StudentId"
                                               onclick="return confirm('Are you sure?')"
                                               title="Delete @item.StudentName">
                                                <i class="bi bi-trash3"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Delete
                                                </span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="table-card-footer">
                        <div class="result-summary">
                            Page
                            <strong>
                                @Model.CurrentPage
                            </strong>
                            of
                            <strong>
                                @Model.TotalPages
                            </strong>
                        </div>

                        <nav aria-label="Student navigation">
                            <ul class="pagination">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/Student/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)"
                                       aria-label="Previous page">
                                        <i class="bi bi-chevron-left"
                                           aria-hidden="true"></i>

                                        <span class="d-none d-sm-inline">
                                            Previous
                                        </span>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link"
                                           href="/Student/Index?searchTerm=@Model.SearchTerm&page=@i"
                                           aria-current="@(Model.CurrentPage == i ? "page" : null)">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/Student/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)"
                                       aria-label="Next page">
                                        <span class="d-none d-sm-inline">
                                            Next
                                        </span>

                                        <i class="bi bi-chevron-right"
                                           aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="empty-state">
                    <div class="empty-state-icon"
                         aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <i class="bi bi-person-x"></i>
                        }
                        else
                        {
                            <i class="bi bi-people"></i>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <h3>
                            No matching students found
                        </h3>

                        <p>
                            No student records matched
                            “@Model.SearchTerm”. Try searching with another
                            name, email address or phone number.
                        </p>

                        <a href="/Student/Index"
                           class="btn btn-outline-primary">
                            <i class="bi bi-arrow-counterclockwise"
                               aria-hidden="true"></i>

                            <span>
                                Clear Search
                            </span>
                        </a>
                    }
                    else
                    {
                        <h3>
                            No student records found
                        </h3>

                        <p>
                            There are currently no student records registered
                            in the library system.
                        </p>

                        <a href="/Student/Create"
                           class="btn btn-primary">
                            <i class="bi bi-person-plus"
                               aria-hidden="true"></i>

                            <span>
                                Add New Student
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>