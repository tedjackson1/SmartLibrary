@model LMSystem.Models.StudentModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Student Management
            </p>

            <h2 class="page-title">
                Add Student
            </h2>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="addStudentFormTitle">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-7">
                <div class="app-card">
                    <div class="app-card-header">
                        <div>
                            <h3 id="addStudentFormTitle"
                                class="section-title">
                                <i class="bi bi-person-plus me-2"
                                   aria-hidden="true"></i>

                                Student Information
                            </h3>
                        </div>
                    </div>

                    <div class="app-card-body">
                        <form asp-action="Create"
                              method="post"
                              onsubmit="return validateForm();">
                            <div class="mb-3">
                                <label class="form-label">
                                    Student Name
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-person input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="StudentName"
                                           class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Email
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-envelope input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Phone
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-telephone input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="Phone"
                                           class="form-control" />
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit"
                                        class="btn btn-success">
                                    <i class="bi bi-person-check"
                                       aria-hidden="true"></i>

                                    <span>
                                        Add
                                    </span>
                                </button>

                                <a asp-action="Index"
                                   class="btn btn-secondary">
                                    <i class="bi bi-x-circle"
                                       aria-hidden="true"></i>

                                    <span>
                                        Cancel
                                    </span>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    function validateForm() {
        const studentName =
            document.querySelector('[name="StudentName"]').value.trim();

        const email =
            document.querySelector('[name="Email"]').value.trim();

        const phone =
            document.querySelector('[name="Phone"]').value.trim();

        if (!studentName || !email || !phone) {
            alert("All fields are required: Student Name, Email, and Phone.");
            return false;
        }

        return true;
    }
</script>