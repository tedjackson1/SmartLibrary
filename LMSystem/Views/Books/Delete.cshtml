@model LMSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Book Catalogue
            </p>

            <h2 class="page-title">
                Delete Book
            </h2>

            <p class="page-description">
                Review the book information carefully before permanently
                deleting this catalogue record.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               asp-controller="Books"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to Books
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="deleteBookConfirmationTitle">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-9">
                <div class="danger-panel">
                    <div class="danger-icon"
                         aria-hidden="true">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <p class="page-eyebrow text-danger">
                        Permanent Action
                    </p>

                    <h3 id="deleteBookConfirmationTitle">
                        Are you sure you want to delete this book?
                    </h3>

                    <p>
                        You are about to permanently remove
                        <strong>@Model.Title</strong>
                        from the library catalogue.
                    </p>

                    <div class="danger-warning-box"
                         role="alert">
                        <i class="bi bi-shield-exclamation"
                           aria-hidden="true"></i>

                        <span>
                            Once deleted, this action cannot be undone.
                        </span>
                    </div>

                    <div class="app-card">
                        <div class="app-card-header">
                            <div>
                                <h4 class="section-title">
                                    <i class="bi bi-journal-bookmark me-2"
                                       aria-hidden="true"></i>

                                    Book Information
                                </h4>

                                <p class="section-description">
                                    Catalogue record number @Model.BookId
                                </p>
                            </div>

                            @if (Model.IsAvailable)
                            {
                                <span class="status-badge status-available">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-unavailable">
                                    Checked Out
                                </span>
                            }
                        </div>

                        <div class="app-card-body">
                            <dl class="detail-list">
                                <div class="detail-row">
                                    <dt class="detail-label">
                                        <i class="bi bi-book me-2"
                                           aria-hidden="true"></i>

                                        Title
                                    </dt>

                                    <dd class="detail-value">
                                        @Model.Title
                                    </dd>
                                </div>

                                <div class="detail-row">
                                    <dt class="detail-label">
                                        <i class="bi bi-person me-2"
                                           aria-hidden="true"></i>

                                        Author
                                    </dt>

                                    <dd class="detail-value">
                                        @Model.Author
                                    </dd>
                                </div>

                                <div class="detail-row">
                                    <dt class="detail-label">
                                        <i class="bi bi-upc-scan me-2"
                                           aria-hidden="true"></i>

                                        ISBN
                                    </dt>

                                    <dd class="detail-value">
                                        @Model.ISBN
                                    </dd>
                                </div>

                                <div class="detail-row">
                                    <dt class="detail-label">
                                        <i class="bi bi-calendar3 me-2"
                                           aria-hidden="true"></i>

                                        Published Date
                                    </dt>

                                    <dd class="detail-value">
                                        @Model.PublishedDate.ToString("yyyy-MM-dd")
                                    </dd>
                                </div>

                                <div class="detail-row">
                                    <dt class="detail-label">
                                        <i class="bi bi-check-circle me-2"
                                           aria-hidden="true"></i>

                                        Availability
                                    </dt>

                                    <dd class="detail-value">
                                        @if (Model.IsAvailable)
                                        {
                                            <span class="status-badge status-available">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-unavailable">
                                                Checked Out
                                            </span>
                                        }
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>

                    <div class="form-actions">
                        <form asp-action="Delete"
                              asp-controller="Books"
                              method="post">
                            <input type="hidden"
                                   asp-for="BookId" />

                            <button type="submit"
                                    class="btn btn-danger">
                                <i class="bi bi-trash3-fill"
                                   aria-hidden="true"></i>

                                <span>
                                    Delete Book
                                </span>
                            </button>
                        </form>

                        <a asp-action="Details"
                           asp-controller="Books"
                           asp-route-id="@Model.BookId"
                           class="btn btn-outline-primary">
                            <i class="bi bi-eye"
                               aria-hidden="true"></i>

                            <span>
                                View Details
                            </span>
                        </a>

                        <a asp-action="Index"
                           asp-controller="Books"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"
                               aria-hidden="true"></i>

                            <span>
                                Cancel
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>