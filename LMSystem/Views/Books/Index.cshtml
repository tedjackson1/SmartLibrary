@model LMSystem.Models.BookListViewModel

@{
    ViewData["Title"] = "Books";

    int displayedBookCount =
        Model.Books?.Count() ?? 0;
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Library Catalogue
            </p>

            <h2 class="page-title">
                Books
            </h2>

            <p class="page-description">
                Browse and manage the books available in the library catalogue.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"
                   aria-hidden="true"></i>

                <span>
                    Create New
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="bookCatalogueTitle">
        <div class="list-toolbar">
            <div class="list-toolbar-left">
                <form asp-action="Index"
                      method="get"
                      class="search-form"
                      role="search">
                    <div class="search-input-group">
                        <i class="bi bi-search search-icon"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="searchQuery"
                               value="@Model.SearchQuery"
                               class="form-control"
                               placeholder="Search by title, author or ISBN"
                               aria-label="Search books" />

                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <a asp-action="Index"
                               class="search-clear-button"
                               aria-label="Clear book search"
                               title="Clear search">
                                <i class="bi bi-x-lg"
                                   aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>

            <div class="list-toolbar-right">
                <div class="result-summary">
                    <strong>
                        @displayedBookCount
                    </strong>

                    @(displayedBookCount == 1 ? "book" : "books")
                    on this page
                </div>

                <button type="submit"
                        form="bookSearchForm"
                        class="d-none"
                        aria-hidden="true"
                        tabindex="-1">
                    Search
                </button>
            </div>
        </div>

        @if (Model.Books != null && Model.Books.Any())
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th scope="col">
                                    Title
                                </th>

                                <th scope="col">
                                    Author
                                </th>

                                <th scope="col">
                                    ISBN
                                </th>

                                <th scope="col">
                                    Status
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Books)
                            {
                                <tr>
                                    <td>
                                        <div class="table-cell-with-icon">
                                            <span class="table-avatar"
                                                  aria-hidden="true">
                                                <i class="bi bi-book"></i>
                                            </span>

                                            <div class="table-cell-stack">
                                                <span class="table-primary-text">
                                                    @item.Title
                                                </span>

                                                <span class="table-secondary-text">
                                                    Book ID: @item.BookId
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="table-primary-text">
                                            @item.Author
                                        </span>
                                    </td>

                                    <td>
                                        <span class="table-number">
                                            @item.ISBN
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="status-badge status-available">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-unavailable">
                                                Borrowed
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="table-actions">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.BookId"
                                               class="btn btn-sm btn-soft-warning"
                                               title="Edit @item.Title">
                                                <i class="bi bi-pencil-square"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Edit
                                                </span>
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.BookId"
                                               class="btn btn-sm btn-soft-primary"
                                               title="View details for @item.Title">
                                                <i class="bi bi-eye"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Details
                                                </span>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.BookId"
                                               class="btn btn-sm btn-soft-danger"
                                               title="Delete @item.Title">
                                                <i class="bi bi-trash3"
                                                   aria-hidden="true"></i>

                                                <span>
                                                    Delete
                                                </span>
                                            </a>

                                            @if (item.IsAvailable)
                                            {
                                                <a asp-controller="Borrow"
                                                   asp-action="Create"
                                                   asp-route-bookId="@item.BookId"
                                                   class="btn btn-sm btn-primary"
                                                   title="Borrow @item.Title">
                                                    <i class="bi bi-box-arrow-up-right"
                                                       aria-hidden="true"></i>

                                                    <span>
                                                        Borrow
                                                    </span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="table-card-footer">
                        <div class="result-summary">
                            Page
                            <strong>
                                @Model.CurrentPage
                            </strong>
                            of
                            <strong>
                                @Model.TotalPages
                            </strong>
                        </div>

                        <nav aria-label="Book catalogue pages">
                            <ul class="pagination">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : string.Empty)">
                                    @if (Model.CurrentPage <= 1)
                                    {
                                        <span class="page-link"
                                              aria-hidden="true">
                                            <i class="bi bi-chevron-left"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-action="Index"
                                           asp-route-searchQuery="@Model.SearchQuery"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           class="page-link"
                                           aria-label="Previous page">
                                            <i class="bi bi-chevron-left"
                                               aria-hidden="true"></i>
                                        </a>
                                    }
                                </li>

                                @for (int pageNumber = 1;
                                      pageNumber <= Model.TotalPages;
                                      pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                                        @if (pageNumber == Model.CurrentPage)
                                        {
                                            <span class="page-link"
                                                  aria-current="page">
                                                @pageNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-action="Index"
                                               asp-route-searchQuery="@Model.SearchQuery"
                                               asp-route-page="@pageNumber"
                                               class="page-link">
                                                @pageNumber
                                            </a>
                                        }
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : string.Empty)">
                                    @if (Model.CurrentPage >= Model.TotalPages)
                                    {
                                        <span class="page-link"
                                              aria-hidden="true">
                                            <i class="bi bi-chevron-right"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-action="Index"
                                           asp-route-searchQuery="@Model.SearchQuery"
                                           asp-route-page="@(Model.CurrentPage + 1)"
                                           class="page-link"
                                           aria-label="Next page">
                                            <i class="bi bi-chevron-right"
                                               aria-hidden="true"></i>
                                        </a>
                                    }
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="empty-state">
                    <div class="empty-state-icon"
                         aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <i class="bi bi-search"></i>
                        }
                        else
                        {
                            <i class="bi bi-journal-x"></i>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <h3>
                            No matching books found
                        </h3>

                        <p>
                            No books matched the search
                            “@Model.SearchQuery”. Try another title,
                            author or ISBN.
                        </p>

                        <a asp-action="Index"
                           class="btn btn-outline-primary">
                            <i class="bi bi-arrow-counterclockwise"
                               aria-hidden="true"></i>

                            <span>
                                Clear Search
                            </span>
                        </a>
                    }
                    else
                    {
                        <h3>
                            No books available
                        </h3>

                        <p>
                            The library catalogue does not contain any
                            book records yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-primary">
                            <i class="bi bi-plus-lg"
                               aria-hidden="true"></i>

                            <span>
                                Create New
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>