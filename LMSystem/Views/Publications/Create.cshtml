@model LMSystem.Models.Publication

@{
    string currentType =
        ViewData["CurrentType"]?.ToString() ?? "Newspaper";

    ViewData["Title"] = "Add New " + currentType;

    bool isMagazine =
        currentType.Equals(
            "Magazine",
            StringComparison.OrdinalIgnoreCase
        );
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Publication Management
            </p>

            <h2 class="page-title">
                Add New @currentType
            </h2>

            <p class="page-description">
                Enter the publication information below to add a new
                @currentType.ToLower() record to the library system.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               asp-route-type="@currentType"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to List
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="createPublicationFormTitle">
        <div class="details-grid">
            <article class="app-card">
                <div class="app-card-header">
                    <div>
                        <h3 id="createPublicationFormTitle"
                            class="section-title">
                            @if (isMagazine)
                            {
                                <i class="bi bi-journals me-2"
                                   aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="bi bi-newspaper me-2"
                                   aria-hidden="true"></i>
                            }

                            @currentType Information
                        </h3>

                        <p class="section-description">
                            Complete all required fields before saving
                            the publication entry.
                        </p>
                    </div>

                    <span class="type-badge">
                        @if (isMagazine)
                        {
                            <i class="bi bi-journals"
                               aria-hidden="true"></i>
                        }
                        else
                        {
                            <i class="bi bi-newspaper"
                               aria-hidden="true"></i>
                        }

                        @currentType
                    </span>
                </div>

                <div class="app-card-body">
                    <form asp-action="Create"
                          method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary-errors"></div>

                        <input type="hidden"
                               asp-for="Type" />

                        <input type="hidden"
                               asp-for="IsAvailable" />

                        <div class="form-section">
                            <div class="mb-4">
                                <label asp-for="Title"
                                       class="form-label">
                                    Title

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    @if (isMagazine)
                                    {
                                        <i class="bi bi-journal-text input-icon"
                                           aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-newspaper input-icon"
                                           aria-hidden="true"></i>
                                    }

                                    <input asp-for="Title"
                                           class="form-control"
                                           placeholder="Enter title name"
                                           autofocus />
                                </div>

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Publisher"
                                       class="form-label">
                                    Publisher

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-building input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="Publisher"
                                           class="form-control"
                                           placeholder="Enter publisher name" />
                                </div>

                                <span asp-validation-for="Publisher"
                                      class="text-danger"></span>
                            </div>

                            <div>
                                <label asp-for="PublishedDate"
                                       class="form-label">
                                    Published Date

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-calendar3 input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="PublishedDate"
                                           type="date"
                                           class="form-control" />
                                </div>

                                <span asp-validation-for="PublishedDate"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Save Entry
                                </span>
                            </button>

                            <a asp-action="Index"
                               asp-route-type="@currentType"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Back to List
                                </span>
                            </a>
                        </div>
                    </form>
                </div>
            </article>

            <aside class="detail-feature-card"
                   aria-label="@currentType entry information">
                <div class="detail-feature-icon">
                    @if (isMagazine)
                    {
                        <i class="bi bi-journals"
                           aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="bi bi-newspaper"
                           aria-hidden="true"></i>
                    }
                </div>

                <p class="mb-2">
                    New Publication
                </p>

                <h3>
                    Add @currentType
                </h3>

                <p>
                    Create a new @currentType.ToLower() record using its
                    title, publisher and publication date.
                </p>

                <div class="mt-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle"
                           aria-hidden="true"></i>

                        <span>
                            The publication type will remain set to
                            @currentType.
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-calendar-check"
                           aria-hidden="true"></i>

                        <span>
                            Confirm the published date before saving
                            the entry.
                        </span>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}