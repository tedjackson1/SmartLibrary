@model LMSystem.Models.Publication

@{
    string currentType =
        ViewData["CurrentType"]?.ToString() ?? "Newspaper";

    ViewData["Title"] = "Modify " + currentType;

    bool isMagazine =
        currentType.Equals(
            "Magazine",
            StringComparison.OrdinalIgnoreCase
        );
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Publication Management
            </p>

            <h2 class="page-title">
                Modify @currentType
            </h2>

            <p class="page-description">
                Update the existing @currentType.ToLower() information
                and availability status.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               asp-route-type="@currentType"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to List
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="editPublicationFormTitle">
        <div class="details-grid">
            <article class="app-card">
                <div class="app-card-header">
                    <div>
                        <h3 id="editPublicationFormTitle"
                            class="section-title">
                            @if (isMagazine)
                            {
                                <i class="bi bi-journals me-2"
                                   aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="bi bi-newspaper me-2"
                                   aria-hidden="true"></i>
                            }

                            Modify @currentType Details
                        </h3>

                        <p class="section-description">
                            Edit the existing details and save the updated record.
                        </p>
                    </div>

                    <span class="type-badge">
                        <i class="bi bi-hash"
                           aria-hidden="true"></i>

                        Publication ID: @Model.Id
                    </span>
                </div>

                <div class="app-card-body">
                    <form asp-action="Edit"
                          method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary-errors"></div>

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="Type" />

                        <div class="form-section">
                            <div class="mb-4">
                                <label asp-for="Title"
                                       class="form-label">
                                    Title

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    @if (isMagazine)
                                    {
                                        <i class="bi bi-journal-text input-icon"
                                           aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-newspaper input-icon"
                                           aria-hidden="true"></i>
                                    }

                                    <input asp-for="Title"
                                           class="form-control"
                                           placeholder="Enter title name"
                                           autofocus />
                                </div>

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Publisher"
                                       class="form-label">
                                    Publisher

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-building input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="Publisher"
                                           class="form-control"
                                           placeholder="Enter publisher name" />
                                </div>

                                <span asp-validation-for="Publisher"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="PublishedDate"
                                       class="form-label">
                                    Published Date

                                    <span class="required-mark"
                                          aria-hidden="true">
                                        *
                                    </span>
                                </label>

                                <div class="input-icon-wrapper">
                                    <i class="bi bi-calendar3 input-icon"
                                       aria-hidden="true"></i>

                                    <input asp-for="PublishedDate"
                                           type="date"
                                           class="form-control" />
                                </div>

                                <span asp-validation-for="PublishedDate"
                                      class="text-danger"></span>
                            </div>

                            <div class="availability-control">
                                <div class="availability-control-content">
                                    <span class="availability-control-icon"
                                          aria-hidden="true">
                                        <i class="bi bi-check-circle"></i>
                                    </span>

                                    <div>
                                        <label asp-for="IsAvailable"
                                               class="availability-control-title">
                                            Mark item as available
                                        </label>

                                        <p class="availability-control-description">
                                            Choose whether this publication is
                                            currently available in the library.
                                        </p>
                                    </div>
                                </div>

                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsAvailable"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           aria-label="Mark publication as available" />
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="btn btn-warning">
                                <i class="bi bi-check-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Update Changes
                                </span>
                            </button>

                            <a asp-action="Index"
                               asp-route-type="@currentType"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Cancel
                                </span>
                            </a>
                        </div>
                    </form>
                </div>
            </article>

            <aside class="detail-feature-card"
                   aria-label="@currentType record information">
                <div class="detail-feature-icon">
                    @if (isMagazine)
                    {
                        <i class="bi bi-journals"
                           aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="bi bi-newspaper"
                           aria-hidden="true"></i>
                    }
                </div>

                <p class="mb-2">
                    Existing Publication
                </p>

                <h3>
                    @Model.Title
                </h3>

                <p>
                    Update this @currentType.ToLower() record without
                    changing its publication type.
                </p>

                <div class="mt-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-building"
                           aria-hidden="true"></i>

                        <span>
                            @Model.Publisher
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-calendar3"
                           aria-hidden="true"></i>

                        <span>
                            @Model.PublishedDate.ToString("yyyy-MM-dd")
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-start gap-2">
                        @if (Model.IsAvailable)
                        {
                            <i class="bi bi-check-circle-fill"
                               aria-hidden="true"></i>

                            <span>
                                Currently marked as available
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill"
                               aria-hidden="true"></i>

                            <span>
                                Currently marked as unavailable
                            </span>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}