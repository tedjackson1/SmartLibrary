@model LMSystem.ViewModels.ReturnViewModel

@{
    ViewData["Title"] = "Return Book";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Borrowing Management
            </p>

            <h2 class="page-title">
                Return Book
            </h2>

            <p class="page-description">
                Review the borrowing information before confirming the return.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               asp-controller="Books"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to Books
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="returnBookTitle">
        <div class="details-grid">
            <article class="app-card">
                <div class="app-card-header">
                    <div>
                        <h3 id="returnBookTitle"
                            class="section-title">
                            <i class="bi bi-arrow-counterclockwise me-2"
                               aria-hidden="true"></i>

                            Return Confirmation
                        </h3>

                        <p class="section-description">
                            Check the transaction details shown below.
                        </p>
                    </div>

                    <span class="type-badge">
                        <i class="bi bi-hash"
                           aria-hidden="true"></i>

                        Record ID: @Model.BorrowRecordId
                    </span>
                </div>

                <div class="app-card-body">
                    <dl class="detail-list">
                        <div class="detail-row">
                            <dt class="detail-label">
                                <i class="bi bi-book me-2"
                                   aria-hidden="true"></i>

                                Book Title
                            </dt>

                            <dd class="detail-value">
                                @Model.BookTitle
                            </dd>
                        </div>

                        <div class="detail-row">
                            <dt class="detail-label">
                                <i class="bi bi-person me-2"
                                   aria-hidden="true"></i>

                                Borrower Name
                            </dt>

                            <dd class="detail-value">
                                @Model.BorrowerName
                            </dd>
                        </div>

                        <div class="detail-row">
                            <dt class="detail-label">
                                <i class="bi bi-calendar-event me-2"
                                   aria-hidden="true"></i>

                                Borrow Date
                            </dt>

                            <dd class="detail-value">
                                @Model.BorrowDate?.ToString("yyyy-MM-dd HH:mm:ss")
                            </dd>
                        </div>
                    </dl>
                </div>

                <div class="app-card-footer">
                    <form asp-action="Return"
                          method="post">
                        <input type="hidden"
                               asp-for="BorrowRecordId" />

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-check-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Confirm Return
                                </span>
                            </button>

                            <a asp-action="Index"
                               asp-controller="Books"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Cancel
                                </span>
                            </a>
                        </div>
                    </form>
                </div>
            </article>

            <aside class="detail-feature-card"
                   aria-label="Selected book">
                <div class="detail-feature-icon">
                    <i class="bi bi-book-half"
                       aria-hidden="true"></i>
                </div>

                <p class="mb-2">
                    Selected Book
                </p>

                <h3>
                    @Model.BookTitle
                </h3>

                <div class="mt-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-check"
                           aria-hidden="true"></i>

                        <span>
                            @Model.BorrowerName
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history"
                           aria-hidden="true"></i>

                        <span>
                            @Model.BorrowDate?.ToString("yyyy-MM-dd HH:mm:ss")
                        </span>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>