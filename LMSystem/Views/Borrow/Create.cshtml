@model LMSystem.ViewModels.BorrowViewModel

@{
    ViewData["Title"] = "Borrow Book";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                Borrowing Management
            </p>

            <h2 class="page-title">
                Borrow Book
            </h2>

            <p class="page-description">
                Enter the borrower’s information to complete the borrowing process.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="Index"
               asp-controller="Books"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"
                   aria-hidden="true"></i>

                <span>
                    Back to Books
                </span>
            </a>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="borrowBookFormTitle">
        <div class="details-grid">
            <article class="app-card">
                <div class="app-card-header">
                    <div>
                        <h3 id="borrowBookFormTitle"
                            class="section-title">
                            <i class="bi bi-person-lines-fill me-2"
                               aria-hidden="true"></i>

                            Borrower Information
                        </h3>

                        <p class="section-description">
                            Provide the details of the person borrowing this book.
                        </p>
                    </div>
                </div>

                <div class="app-card-body">
                    <form asp-action="Create"
                          method="post">
                        <input type="hidden"
                               asp-for="BookId" />

                        <div class="form-section">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div>
                                        <label asp-for="BorrowerName"
                                               class="form-label">
                                            Borrower Name

                                            <span class="required-mark"
                                                  aria-hidden="true">
                                                *
                                            </span>
                                        </label>

                                        <div class="input-icon-wrapper">
                                            <i class="bi bi-person input-icon"
                                               aria-hidden="true"></i>

                                            <input asp-for="BorrowerName"
                                                   class="form-control"
                                                   placeholder="Enter the borrower’s full name" />
                                        </div>

                                        <span asp-validation-for="BorrowerName"
                                              class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div>
                                        <label asp-for="BorrowerEmail"
                                               class="form-label">
                                            Borrower Email

                                            <span class="required-mark"
                                                  aria-hidden="true">
                                                *
                                            </span>
                                        </label>

                                        <div class="input-icon-wrapper">
                                            <i class="bi bi-envelope input-icon"
                                               aria-hidden="true"></i>

                                            <input asp-for="BorrowerEmail"
                                                   class="form-control"
                                                   placeholder="Enter the borrower’s email" />
                                        </div>

                                        <span asp-validation-for="BorrowerEmail"
                                              class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div>
                                        <label asp-for="Phone"
                                               class="form-label">
                                            Phone Number

                                            <span class="required-mark"
                                                  aria-hidden="true">
                                                *
                                            </span>
                                        </label>

                                        <div class="input-icon-wrapper">
                                            <i class="bi bi-telephone input-icon"
                                               aria-hidden="true"></i>

                                            <input asp-for="Phone"
                                                   class="form-control"
                                                   placeholder="Enter the borrower’s phone number" />
                                        </div>

                                        <span asp-validation-for="Phone"
                                              class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Confirm Borrow
                                </span>
                            </button>

                            <a asp-action="Index"
                               asp-controller="Books"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"
                                   aria-hidden="true"></i>

                                <span>
                                    Cancel
                                </span>
                            </a>
                        </div>
                    </form>
                </div>
            </article>

            <aside class="detail-feature-card"
                   aria-label="Selected book information">
                <div class="detail-feature-icon">
                    <i class="bi bi-book-half"
                       aria-hidden="true"></i>
                </div>

                <p class="mb-2">
                    Selected Book
                </p>

                <h3>
                    @Model.BookTitle
                </h3>

                <div class="mt-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-hash"
                           aria-hidden="true"></i>

                        <span>
                            Book ID: @Model.BookId
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle"
                           aria-hidden="true"></i>

                        <span>
                            Confirm the borrower’s details before completing
                            this transaction.
                        </span>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}