@{
    ViewData["Title"] = "About Us";
}

<div class="page-container">
    <header class="page-header">
        <div class="page-header-content">
            <p class="page-eyebrow">
                About the System
            </p>

            <h2 class="page-title">
                About Us
            </h2>

            <p class="page-description">
                Learn more about LibraryManagement and how it supports
                students and administrators.
            </p>
        </div>
    </header>

    <section class="page-section"
             aria-labelledby="aboutLibraryManagementTitle">
        <div class="hero-section about-hero-section">
            <div class="hero-content">
                <span class="hero-kicker">
                    <i class="bi bi-book-half"
                       aria-hidden="true"></i>

                    LibraryManagement
                </span>

                <h3 id="aboutLibraryManagementTitle"
                    class="hero-title">
                    Making library resource management simple and accessible.
                </h3>

                <p class="hero-description">
                    Welcome to LibraryManagement, your ultimate portal for digital and
                    physical resource tracking.
                </p>
            </div>

            <div class="about-hero-decoration"
                 aria-hidden="true">
                <i class="bi bi-journals"></i>
            </div>
        </div>
    </section>

    <section class="page-section"
             aria-labelledby="aboutMissionTitle">
        <div class="app-card">
            <div class="app-card-body">
                <div class="about-mission-layout">
                    <div class="about-mission-icon"
                         aria-hidden="true">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <div class="about-mission-content">
                        <p class="page-eyebrow">
                            Our Mission
                        </p>

                        <h3 id="aboutMissionTitle"
                            class="section-title">
                            Simplifying academic library management
                        </h3>

                        <p>
                            Our mission is to simplify school and university cataloging by
                            providing a seamless, fast, and secure database solution for
                            students and administrators alike. Manage books, check availability,
                            and handle borrowing requests with just a few clicks.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="page-section"
             aria-labelledby="aboutValuesTitle">
        <div class="section-header">
            <div>
                <h3 id="aboutValuesTitle"
                    class="section-title">
                    What We Focus On
                </h3>

                <p class="section-description">
                    The principles that guide the LibraryManagement experience.
                </p>
            </div>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <div class="feature-icon"
                     aria-hidden="true">
                    <i class="bi bi-eye"></i>
                </div>

                <h3>
                    Our Vision
                </h3>

                <p>
                    To build connected environments where academic
                    resources are accessible to everyone, instantly.
                </p>
            </article>

            <article class="feature-card">
                <div class="feature-icon"
                     aria-hidden="true">
                    <i class="bi bi-activity"></i>
                </div>

                <h3>
                    Smart Tracking
                </h3>

                <p>
                    Monitor real-time item checkouts, pending return
                    dates, and stock limits automatically.
                </p>
            </article>

            <article class="feature-card">
                <div class="feature-icon"
                     aria-hidden="true">
                    <i class="bi bi-phone"></i>
                </div>

                <h3>
                    Easy Access
                </h3>

                <p>
                    A clean interface optimized for desktop, tablet,
                    and mobile screens alike.
                </p>
            </article>
        </div>
    </section>
</div>